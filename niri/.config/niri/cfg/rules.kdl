prefer-no-csd
window-rule {
    geometry-corner-radius 10
 // Set every window radius to 20    clip-to-geometry true
}
// apps displayed on 100% column width by default
window-rule {
    match app-id="(google-chrome|firefox)"
    //default-column-width {}
    open-maximized true
    open-on-workspace "browser"
}
window-rule {
    match app-id="(Alacritty)"
    open-on-workspace "coding"
}
// if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title="^[Ss]team$"
    open-floating true
}
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

