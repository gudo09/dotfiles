layout {
  gaps 16
  center-focused-column "never"
  background-color "transparent"
  focus-ring {
    active-color "#7fc8ff66"
  }
  shadow {
    on
    color "#FFF59B66"
    inactive-color "#00000000"
    softness 20
  }
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }
  struts {

  }
}

